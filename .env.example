# Copy to .env for local use. Never commit .env.
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NIE=Y1234567X
FULL_NAME=YOUR FULL NAME

# Province 48 is Bizkaia. Override this only if you want another procedure.
PROVINCE_CODE=48
NATIONALITY=MARRUECOS
PROCEDURE_TEXT=POLICÍA-TOMA DE HUELLAS (EXPEDICIÓN DE TARJETA) INICIAL, RENOVACIÓN, DUPLICADO Y LEY 14/2013

# Browser & network settings
HEADLESS=true
# Optional residential proxy URL (e.g., http://user:pass@host:port) to avoid F5 WAF IP blocks
# PROXY_SERVER=http://username:password@residential-proxy-spain.com:8080
